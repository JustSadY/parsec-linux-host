pkgbase = parsec-linux-host
	pkgdesc = Parsec client with an in-process Linux Host settings page and lowlat backend
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/JustSadY/parsec-linux-host
	install = packaging/parsec-linux-host.install
	arch = x86_64
	license = MIT
	license = LicenseRef-Parsec
	makedepends = cargo
	makedepends = patch
	makedepends = gcc
	makedepends = binutils
	makedepends = python
	makedepends = pkgconf
	makedepends = jansson
	depends = glibc
	depends = gcc-libs
	depends = systemd
	depends = polkit
	depends = bubblewrap
	depends = jansson
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libsm
	depends = libglvnd
	depends = alsa-lib
	depends = libjpeg-turbo
	depends = libpng
	depends = curl
	depends = openssl
	depends = ffmpeg
	depends = vulkan-icd-loader
	depends = libva
	depends = libpulse
	optdepends = nvidia-utils: NVIDIA NVENC encoding
	optdepends = mesa: OpenGL conversion and AMD/Intel graphics
	optdepends = vulkan-radeon: AMD Vulkan capture conversion
	optdepends = vulkan-intel: Intel Vulkan capture conversion
	optdepends = wl-clipboard: copy the friend invite link on Wayland
	optdepends = xclip: copy the friend invite link on X11
	provides = parsec-bin=150_105c
	conflicts = parsec-bin
	conflicts = parsec
	noextract = parsec-linux-150_104a.deb
	noextract = parsecd-150-105c.so
	options = !lto
	options = !strip
	backup = etc/parsec-host/settings.json
