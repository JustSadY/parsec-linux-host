pkgbase = parsec-linux-host
	pkgdesc = Native Linux host settings, lowlat backend, and official Parsec client
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/nomi-san/lowlat
	install = packaging/parsec-linux-host.install
	arch = x86_64
	license = MIT
	license = LicenseRef-Parsec
	makedepends = cargo
	makedepends = patch
	depends = glibc
	depends = gcc-libs
	depends = systemd
	depends = polkit
	depends = python
	depends = pyside6
	depends = python-xlib
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libsm
	depends = libglvnd
	depends = alsa-lib
	depends = libjpeg-turbo
	depends = libpng
	depends = curl
	depends = openssl
	depends = ffmpeg
	depends = vulkan-icd-loader
	depends = libva
	depends = libpulse
	optdepends = nvidia-utils: NVIDIA NVENC encoding
	optdepends = mesa: OpenGL conversion and AMD/Intel graphics
	optdepends = vulkan-radeon: AMD Vulkan capture conversion
	optdepends = vulkan-intel: Intel Vulkan capture conversion
	provides = parsec-bin=150_104a
	conflicts = parsec-bin
	conflicts = parsec
