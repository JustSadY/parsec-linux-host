+/// A refusal is sent even before a transport exists. A pending offer never
+/// registers with Admission and therefore owns no socket, capture or input.
+fn decline(client: &mut Client, offer: &OfferRelay) -> Result<(), Box<dyn std::error::Error>> {
+    let empty = no_credentials();
+    client.send(
+        "answer",
+        &Answer {
+            approved: false,
+            attempt_id: &offer.attempt_id,
+            data: AnswerData {
+                base: HostDataBase::default(),
+                creds: &empty,
+            },
+            to: &offer.from,
+        },
+    )?;
+    Ok(())
+}
+
+/// The sole path from an automatic owner decision or a manual guest decision
+/// to the transport. Called only after this application's approval policy.
+fn admit(
+    client: &mut Client,
+    seam: &mut Admission,
+    peers: &mut std::collections::HashMap<String, Introduced>,
+    offer: OfferRelay,
+) -> Result<(), Box<dyn std::error::Error>> {
+    let transport = if offer.data.wants_web() {
+        Transport::Web
+    } else {
+        Transport::Bud
+    };
+    let peer = Peer {
+        ufrag: offer.data.creds.ice_ufrag.clone(),
+        pwd: offer.data.creds.ice_pwd.clone(),
+        aes256: offer.data.creds.aes256.clone(),
+        transport,
+        fingerprint: offer.data.creds.fingerprint.clone(),
+        permissions: lowlat_host::inject::Permissions {
+            keyboard: offer.permissions.keyboard,
+            pointer: offer.permissions.mouse,
+            gamepad: offer.permissions.gamepad,
+        },
+        owner: offer.is_owner,
+    };
+    let refusal = match seam.new_attempt(&offer.attempt_id, peer) {
+        Ok(()) => match seam.begin_p2p(&offer.attempt_id, 0) {
+            Ok(host) => {
+                let creds = Credentials {
+                    aes256: (!host.aes256.is_empty()).then_some(host.aes256),
+                    fingerprint: host.fingerprint,
+                    ice_ufrag: host.ufrag,
+                    ice_pwd: host.pwd,
+                };
+                client.send(
+                    "answer",
+                    &Answer {
+                        approved: true,
+                        attempt_id: &offer.attempt_id,
+                        data: AnswerData {
+                            base: HostDataBase::default(),
+                            creds: &creds,
+                        },
+                        to: &offer.from,
+                    },
+                )?;
+                peers.insert(
+                    offer.attempt_id,
+                    Introduced {
+                        from: offer.from,
+                        name: offer.user.name,
+                    },
+                );
+                lowlat_common::log_info!("lowlatd: answered, guest bound to port {}", host.port);
+                return Ok(());
+            }
+            Err(error) => error.to_string(),
+        },
+        Err(error) => error.to_string(),
+    };
+    lowlat_common::log_info!("lowlatd: declining {}: {refusal}", offer.attempt_id);
+    decline(client, &offer)?;
+    seam.end_connection(&offer.attempt_id);
+    peers.remove(&offer.attempt_id);
+    Ok(())
+}
