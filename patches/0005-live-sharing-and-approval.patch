+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Admission {
+    Refuse,
+    Automatic,
+    Pending,
+}
+
+/// File mode is deliberately different from the old --secret CLI mode. A
+/// missing, disabled, malformed or unreadable file always means owner-only.
+pub(crate) struct Policy {
+    path: Option<PathBuf>,
+    share: Share,
+    owner_only: bool,
+    polled: Instant,
+}
+
+impl Policy {
+    pub(crate) fn new(path: Option<PathBuf>, secret: Option<String>, owner_only: bool) -> Self {
+        let share = path.as_deref().map_or_else(
+            || Share {
+                enabled: false,
+                secret: secret.filter(|text| text.len() >= 8).unwrap_or_default(),
+            },
+            Share::read,
+        );
+        Self {
+            path,
+            share,
+            owner_only,
+            polled: Instant::now(),
+        }
+    }
+
+    /// True only when the effective secret/enabled state changed. No host
+    /// restart, capture rebuild or existing-guest operation belongs here.
+    pub(crate) fn poll(&mut self, now: Instant) -> bool {
+        if now.saturating_duration_since(self.polled) < POLL {
+            return false;
+        }
+        self.polled = now;
+        let Some(path) = self.path.as_deref() else {
+            return false;
+        };
+        let updated = Share::read(path);
+        let changed = self.share != updated;
+        self.share = updated;
+        changed
+    }
+
+    pub(crate) fn enabled(&self) -> bool {
+        self.share.enabled
+    }
+    pub(crate) fn secret(&self) -> &str {
+        &self.share.secret
+    }
+
+    pub(crate) fn admission(&self, owner: bool, reject_all: bool) -> Admission {
+        if reject_all {
+            return Admission::Refuse;
+        }
+        if owner {
+            return Admission::Automatic;
+        }
+        if self.path.is_some() {
+            // skip_approval from signaling never bypasses this policy.
+            if self.enabled() {
+                Admission::Pending
+            } else {
+                Admission::Refuse
+            }
+        } else if self.owner_only {
+            Admission::Refuse
+        } else {
+            // Preserve the old standalone CLI's policy outside file mode.
+            Admission::Automatic
+        }
+    }
+}
+
+struct Pending {
+    id: u64,
+    offer: OfferRelay,
+    expires: Instant,
+}
+
+#[derive(Default)]
+pub(crate) struct PendingOffers {
+    entries: Vec<Pending>,
+}
+
+impl PendingOffers {
+    pub(crate) fn contains(&self, attempt: &str) -> bool {
+        self.entries
+            .iter()
+            .any(|entry| entry.offer.attempt_id == attempt)
+    }
+
+    pub(crate) fn insert(&mut self, offer: OfferRelay, now: Instant) -> Result<u64, &'static str> {
+        if self.contains(&offer.attempt_id) {
+            return Err("duplicate offer");
+        }
+        if self.entries.len() >= PENDING_LIMIT {
+            return Err("approval queue full");
+        }
+        // Exhaustion fails closed, never wrapping onto an earlier decision.
+        let id = next_id(&NEXT_ID)?;
+        self.entries.push(Pending {
+            id,
+            offer,
+            expires: now + APPROVAL_TIMEOUT,
+        });
+        Ok(id)
+    }
+
+    pub(crate) fn cancel(&mut self, attempt: &str) -> bool {
+        let before = self.entries.len();
+        self.entries
+            .retain(|entry| entry.offer.attempt_id != attempt);
+        before != self.entries.len()
+    }
+
+    pub(crate) fn take(&mut self, id: u64, now: Instant) -> Option<OfferRelay> {
+        let at = self
+            .entries
+            .iter()
+            .position(|entry| entry.id == id && now < entry.expires)?;
+        Some(self.entries.remove(at).offer)
+    }
+
+    pub(crate) fn expire(&mut self, now: Instant) -> Vec<OfferRelay> {
+        let mut expired = Vec::new();
+        let mut at = 0;
+        while at < self.entries.len() {
+            if now >= self.entries[at].expires {
+                expired.push(self.entries.remove(at).offer);
+            } else {
+                at += 1
+            }
+        }
+        expired
+    }
+
+    pub(crate) fn drain(&mut self) -> Vec<OfferRelay> {
+        self.entries.drain(..).map(|entry| entry.offer).collect()
+    }
+
+    pub(crate) fn state(&self) -> serde_json::Value {
+        self.entries.iter().map(|entry| serde_json::json!({
+            "id": entry.id,
+            "user_id": entry.offer.user.id,
+            // Remote names are display data, not commands or markup. Bound
+            // the copy sent to every native window as well as the queue.
+            "name": entry.offer.user.name.chars().filter(|c| !c.is_control()).take(96).collect::<String>(),
+        })).collect()
+    }
+}
+
+/// Exactly one numeric decision per tray frame. Reject ambiguous frames so a
+/// malformed request cannot approve merely because one key happened to parse.
+#[cfg_attr(not(target_os = "linux"), allow(dead_code))]
+pub(crate) fn decision(body: &[u8]) -> Option<(u64, bool)> {
+    let value: serde_json::Value = serde_json::from_slice(body).ok()?;
+    let object = value.as_object()?;
+    if object.len() != 1 {
+        return None;
+    }
+    let (id, approved) = if let Some(id) = object.get("approve") {
+        (id.as_u64()?, true)
+    } else {
+        (object.get("reject")?.as_u64()?, false)
+    };
+    (id != 0).then_some((id, approved))
+}
