+/// A complete permission set from the owner; absent or mistyped booleans do
+/// not acquire their permissive default from the remote offer protocol.
+pub(crate) fn is_permissions(body: &[u8]) -> Option<(u32, lowlat_host::inject::Permissions)> {
+    let value: serde_json::Value = serde_json::from_slice(body).ok()?;
+    let value = value.get("permissions")?;
+    let id = u32::try_from(value.get("id")?.as_u64()?).ok()?;
+    let permissions = lowlat_host::inject::Permissions {
+        keyboard: value.get("keyboard")?.as_bool()?,
+        pointer: value.get("mouse")?.as_bool()?,
+        gamepad: value.get("gamepad")?.as_bool()?,
+    };
+    (id != 0).then_some((id, permissions))
+}
