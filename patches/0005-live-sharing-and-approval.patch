index 0000000..6caf350
--- /dev/null
+++ b/crates/daemon/src/sharing.rs
@@ -0,0 +1,464 @@
+//! Live invite policy and a bounded manual-approval queue. No transport is
+//! allocated until a queued offer is explicitly accepted by the desktop owner.
+
+use lowlat_kessel::message::OfferRelay;
+use std::io::Read as _;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::{Duration, Instant};
+
+const FILE_LIMIT: u16 = 4096;
+const POLL: Duration = Duration::from_millis(250);
+const APPROVAL_TIMEOUT: Duration = Duration::from_secs(30);
+const PENDING_LIMIT: usize = 8;
+// Kept outside a signaling session: reconnecting must not recycle an ID a
+// native window might still have in its old Accept/Reject button.
+static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+// Native Jansson's json_int_t is signed, even though our IDs are unsigned.
+const MAX_ID: u64 = 0x7fff_ffff_ffff_ffff;
+
+fn next_id(counter: &AtomicU64) -> Result<u64, &'static str> {
+    // `fetch_update` is available on the project's minimum Rust; its renamed
+    // alias is not yet available on every supported compiler.
+    #[allow(deprecated)]
+    counter
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |id| {
+            (id < MAX_ID).then(|| id + 1)
+        })
+        .map_err(|_| "approval IDs exhausted")
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+struct Share {
+    enabled: bool,
+    secret: String,
+}
+
+impl Share {
+    fn parse(bytes: &[u8]) -> Self {
+        if bytes.len() > usize::from(FILE_LIMIT) {
+            return Self::default();
+        }
+        let Ok(value) = serde_json::from_slice::<serde_json::Value>(bytes) else {
+            return Self::default();
+        };
+        if value.get("enabled").and_then(serde_json::Value::as_bool) != Some(true) {
+            return Self::default();
+        }
+        let Some(secret) = value.get("secret").and_then(serde_json::Value::as_str) else {
+            return Self::default();
+        };
+        // The vendor's native Join parser consumes exactly eight secret bytes.
+        if secret.len() != 8 || !secret.bytes().all(|byte| byte.is_ascii_hexdigit()) {
+            return Self::default();
+        }
+        Self {
+            enabled: true,
+            secret: secret.to_owned(),
+        }
+    }
+
+    fn read(path: &Path) -> Self {
+        let mut options = std::fs::OpenOptions::new();
+        options.read(true);
+        // A broken or replaced state file must not block the signaling loop
+        // on a FIFO, and a link must not redirect this root-owned input.
+        #[cfg(target_os = "linux")]
+        {
+            use std::os::unix::fs::OpenOptionsExt as _;
+            options.custom_flags(libc::O_NONBLOCK | libc::O_NOFOLLOW);
+        }
+        let Ok(file) = options.open(path) else {
+            return Self::default();
+        };
+        if !file.metadata().is_ok_and(|meta| meta.is_file()) {
+            return Self::default();
+        }
+        let mut bytes = Vec::new();
+        if file
+            .take(u64::from(FILE_LIMIT) + 1)
+            .read_to_end(&mut bytes)
+            .is_err()
+        {
+            return Self::default();
+        }
+        Self::parse(&bytes)
+    }
+}
