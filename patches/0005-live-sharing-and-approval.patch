+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn offer(attempt: &str) -> OfferRelay {
+        serde_json::from_value(serde_json::json!({
+            "attempt_id": attempt, "from": "remote-peer", "is_owner": false,
+            "skip_approval": true, "user": {"id": 42, "name": "Guest"},
+            "data": {"creds": {"ice_ufrag":"ufrag", "ice_pwd":"password"}}
+        }))
+        .expect("offer")
+    }
+
+    #[test]
+    fn absent_invalid_and_oversize_states_are_disabled() {
+        for input in [
+            b"".as_slice(),
+            b"null",
+            b"{}",
+            b"[]",
+            b"{",
+            b"{\"enabled\":true}",
+            b"{\"enabled\":1,\"secret\":\"01234567\"}",
+            b"{\"enabled\":true,\"secret\":\"short\"}",
+            b"{\"enabled\":true,\"secret\":\"0123456x\"}",
+        ] {
+            assert_eq!(Share::parse(input), Share::default());
+        }
+        let mut oversized = br#"{"enabled":true,"secret":"01234567"}"#.to_vec();
+        oversized.resize(4097, b' ');
+        assert_eq!(Share::parse(&oversized), Share::default());
+        assert_eq!(
+            Share::read(Path::new("/no-such-lowlat-share-state")),
+            Share::default()
+        );
+    }
+
+    #[test]
+    fn valid_hex_only_and_explicit_enable_are_required() {
+        let live = Share::parse(br#"{"enabled":true,"secret":"89aBcDeF"}"#);
+        assert!(live.enabled);
+        assert_eq!(live.secret, "89aBcDeF");
+        assert_eq!(
+            Share::parse(br#"{"enabled":false,"secret":"0123456789abcdef"}"#),
+            Share::default()
+        );
+        assert_eq!(
+            Share::parse(br#"{"enabled":true,"secret":"0123456789abcdef"}"#),
+            Share::default()
+        );
+    }
+
+    #[test]
+    fn native_signed_id_exhaustion_never_wraps_or_reuses() {
+        let counter = AtomicU64::new(MAX_ID - 1);
+        assert_eq!(next_id(&counter), Ok(MAX_ID - 1));
+        assert!(next_id(&counter).is_err());
+        assert!(next_id(&counter).is_err());
+        assert_eq!(counter.load(Ordering::Relaxed), MAX_ID);
+    }
+
+    #[test]
+    fn reader_rejects_oversize_files_and_non_regular_paths() {
+        let path = std::env::temp_dir().join(format!(
+            "lowlat-share-bounds-{}-{}",
+            std::process::id(),
+            next_id(&NEXT_ID).unwrap()
+        ));
+        std::fs::create_dir(&path).unwrap();
+        assert_eq!(Share::read(&path), Share::default());
+        let file = path.join("state.json");
+        let mut bytes = br#"{"enabled":true,"secret":"01234567"}"#.to_vec();
+        bytes.resize(4096, b' ');
+        std::fs::write(&file, &bytes).unwrap();
+        assert!(Share::read(&file).enabled);
+        bytes.push(b' ');
+        std::fs::write(&file, bytes).unwrap();
+        assert_eq!(Share::read(&file), Share::default());
+        #[cfg(target_os = "linux")]
+        {
+            std::fs::write(&file, br#"{"enabled":true,"secret":"01234567"}"#).unwrap();
+            let link = path.join("linked.json");
+            std::os::unix::fs::symlink(&file, &link).unwrap();
+            assert_eq!(Share::read(&link), Share::default());
+        }
+        std::fs::remove_dir_all(&path).unwrap();
+    }
+
+    #[test]
+    fn file_mode_admits_only_owners_automatically() {
+        let mut policy = Policy::new(
+            Some(PathBuf::from("/no-such-lowlat-share-state")),
+            Some("legacysecret".into()),
+            false,
+        );
+        assert_eq!(policy.admission(true, false), Admission::Automatic);
+        assert_eq!(policy.admission(false, false), Admission::Refuse);
+        assert_eq!(policy.secret(), "");
+        policy.share = Share::parse(br#"{"enabled":true,"secret":"01234567"}"#);
+        assert_eq!(policy.admission(false, false), Admission::Pending);
+        assert_eq!(policy.admission(true, true), Admission::Refuse);
+        // The queue retains skip_approval but the policy never reads it.
+        assert!(offer("one").skip_approval);
+    }
+
+    #[test]
+    fn standalone_cli_keeps_its_existing_policy() {
+        assert_eq!(
+            Policy::new(None, None, true).admission(false, false),
+            Admission::Refuse
+        );
+        let policy = Policy::new(None, Some("old-cli-secret".into()), false);
+        assert_eq!(policy.admission(false, false), Admission::Automatic);
+        assert_eq!(policy.secret(), "old-cli-secret");
+    }
+
+    #[test]
+    fn decisions_are_numeric_unambiguous_and_nonzero() {
+        assert_eq!(decision(br#"{"approve":9}"#), Some((9, true)));
+        assert_eq!(decision(br#"{"reject":9}"#), Some((9, false)));
+        for frame in [
+            br#"{"approve":0}"#.as_slice(),
+            br#"{"approve":-1}"#,
+            br#"{"approve":"9"}"#,
+            br#"{"approve":9,"reject":9}"#,
+            br#"{"approve":1.1}"#,
+            b"null",
+        ] {
+            assert_eq!(decision(frame), None);
+        }
+    }
+
+    #[test]
+    fn decisions_are_one_shot_cancelled_and_expired_ids_never_admit() {
+        let now = Instant::now();
+        let mut pending = PendingOffers::default();
+        let first = pending.insert(offer("first"), now).unwrap();
+        assert_eq!(pending.take(first, now).unwrap().attempt_id, "first");
+        assert!(pending.take(first, now).is_none());
+        let cancelled = pending.insert(offer("cancelled"), now).unwrap();
+        assert!(pending.cancel("cancelled"));
+        assert!(pending.take(cancelled, now).is_none());
+        let expired = pending.insert(offer("expired"), now).unwrap();
+        assert!(pending.take(expired, now + APPROVAL_TIMEOUT).is_none());
+        assert_eq!(pending.expire(now + APPROVAL_TIMEOUT).len(), 1);
+        assert!(pending.take(expired, now).is_none());
+        let next = PendingOffers::default()
+            .insert(offer("next-session"), now)
+            .unwrap();
+        assert!(first < cancelled && cancelled < expired && expired < next);
+    }
+
+    #[test]
+    fn pending_queue_is_bounded_duplicate_safe_and_revocable() {
+        let now = Instant::now();
+        let mut pending = PendingOffers::default();
+        let first = pending.insert(offer("0"), now).unwrap();
+        assert!(pending.insert(offer("0"), now).is_err());
+        for index in 1..PENDING_LIMIT {
+            pending.insert(offer(&index.to_string()), now).unwrap();
+        }
+        assert!(pending.insert(offer("overflow"), now).is_err());
+        assert_eq!(pending.state().as_array().unwrap().len(), PENDING_LIMIT);
+        assert_eq!(pending.state()[0]["user_id"], 42);
+        assert_eq!(pending.drain().len(), PENDING_LIMIT);
+        assert!(pending.take(first, now).is_none());
+    }
+
+    #[test]
+    fn names_are_bounded_display_data() {
+        let mut incoming = offer("one");
+        incoming.user.name = format!("\n{}\u{1b}", "ç".repeat(200));
+        let mut pending = PendingOffers::default();
+        pending.insert(incoming, Instant::now()).unwrap();
+        assert_eq!(
+            pending.state()[0]["name"].as_str().unwrap().chars().count(),
+            96
+        );
+    }
+
+    #[test]
+    fn polling_is_live_bounded_and_sends_only_effective_changes() {
+        let path = std::env::temp_dir().join(format!(
+            "lowlat-share-test-{}-{}",
+            std::process::id(),
+            NEXT_ID.fetch_add(1, Ordering::Relaxed)
+        ));
+        std::fs::write(&path, br#"{"enabled":true,"secret":"01234567"}"#).unwrap();
+        let mut policy = Policy::new(Some(path.clone()), None, true);
+        let start = policy.polled;
+        assert!(policy.enabled());
+        assert!(!policy.poll(start + POLL));
+        std::fs::write(&path, br#"{"enabled":true,"secret":"89abcdef"}"#).unwrap();
+        assert!(!policy.poll(start + POLL + Duration::from_millis(1)));
+        assert!(policy.poll(start + POLL * 2));
+        assert_eq!(policy.secret(), "89abcdef");
+        std::fs::remove_file(&path).unwrap();
+        assert!(policy.poll(start + POLL * 3));
+        assert!(!policy.enabled());
+        assert!(!policy.poll(start + POLL * 4));
+    }
