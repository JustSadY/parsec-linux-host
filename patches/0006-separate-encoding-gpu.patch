+    /// Prefer cached system memory for CPU readback; reading uncached BAR
+    /// memory byte by byte can be much slower than a DMA transfer to RAM.
+    pub(crate) fn host_readback_memory(&self, allowed: u32) -> Result<u32, Error> {
+        let memory = unsafe {
+            self.instance
+                .get_physical_device_memory_properties(self.physical)
+        };
+        cached_readback_index(
+            &memory.memory_types[..memory.memory_type_count as usize],
+            allowed,
+        )
+        .map_or_else(|| self.host_visible_memory(allowed), Ok)
+    }
