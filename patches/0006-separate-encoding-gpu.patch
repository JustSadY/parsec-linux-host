+fn cached_readback_index(types: &[vk::MemoryType], allowed: u32) -> Option<u32> {
+    let wanted = vk::MemoryPropertyFlags::HOST_VISIBLE
+        | vk::MemoryPropertyFlags::HOST_COHERENT
+        | vk::MemoryPropertyFlags::HOST_CACHED;
+    types
+        .iter()
+        .enumerate()
+        .find(|(at, kind)| {
+            *at < 32 && allowed & (1 << at) != 0 && kind.property_flags.contains(wanted)
+        })
+        .and_then(|(at, _)| u32::try_from(at).ok())
+}
